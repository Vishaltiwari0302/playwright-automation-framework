# ---- General / Run ----
# Comma-separated, e.g. "chromium,firefox"
BROWSERS=chromium

# ---- Sample Web App (UI) ----
# Base URL of the application under test
BASE_URL=https://petstore.swagger.io

# Default UI login credentials
# (use the credentials appropriate for the app under test)
USERNAME=admin
PASSWORD=password123

# ---- API ----
# Base URL of the REST API under test (e.g. Petstore)
API_BASE_URL=https://petstore.swagger.io/v2

# API auth key (if required)
API_KEY=

# ---- Test Data ----
# Optional override: comma-separated list of pets to seed via API
SEED_PET_NAMES=Rex,Milo
