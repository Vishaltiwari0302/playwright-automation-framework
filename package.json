{
  "name": "playwright-automation-framework",
  "version": "1.0.0",
  "description": "TypeScript + Playwright automation framework with Page Object Model (UI) and an integrated API layer.",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test tests/ui --reporter=list",
    "test:api": "playwright test tests/api --reporter=list",
    "test:headed": "playwright test --headed --debug",
    "test:report": "playwright show-report",
    "test:chrome": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:parallel": "playwright test --workers=2",
    "clean": "rm -rf test-results/ playwright-report/ reports/",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "playwright",
    "typescript",
    "automation",
    "page-object-model",
    "api-testing",
    "e2e"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@playwright/test": "^1.49.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "dotenv": "^16.4.5"
  },
  "engines": {
    "node": ">=18"
  }
}
